local function IsPlayerAlive()
    local char = player.Character
    local hum  = char and char:FindFirstChildOfClass("Humanoid")
    return hum ~= nil and hum.Health > 0
end

-- ─── Kiểm tra mob còn sống ────────────────────────────────────────────
local function IsMobAlive(mob, genvKey)
    if not mob or not mob.Parent then return false end
    local data = SEA_MOB_MAP[genvKey]
    if not data then return false end
    if data.isSeaBeast then
        local hp = mob:FindFirstChild("Health")
        return hp and hp.Value > 0
    elseif data.isBoat then
        local hp = mob:FindFirstChild("Health")
        return hp and hp.Value > 0 and mob:FindFirstChild("VehicleSeat") ~= nil
    else
        local hum = mob:FindFirstChild("Humanoid")
        return hum and hum.Health > 0
    end
end

-- ─── Lấy CFrame farm chính xác theo từng loại mob ────────────────────
-- ─── Offset Y khi WeaponConfig = "Gun" ───────────────────────────────
-- Shark / Piranha / TerrorShark / FishCrewMember  → Ymob + 100
-- Haunted Crew Member / PirateGrandBrigade / FishBoat → Ymob + 150
-- SeaBeast (Gun) dùng Orbit riêng (radius 100, Y + 100)
local GUN_Y_OFFSET_NORMAL = 100
local GUN_Y_OFFSET_EXTRA  = 150   -- Haunted + boats
local GUN_ORBIT_RADIUS    = 100
local GUN_ORBIT_Y_OFFSET  = 100
local GUN_ORBIT_SPEED     = 3.5

-- Flag né skill (khai báo sớm để Orbit / Dodge dùng chung)
local seaBeastIsDodging  = false
local seaBeastDodgeConn  = nil

local function IsGunWeapon()
    return (_G.ChooseWP or Config.Settings.WeaponConfig or "") == "Gun"
end

local function GetMobFarmCFrame(mob, genvKey)
    local data = SEA_MOB_MAP[genvKey]
    if not data then return nil end

    local useGunLogic = IsGunWeapon()

    if data.isBoat then
        local eng = mob:FindFirstChild("Engine")
        if not eng then return nil end

        if useGunLogic then
            -- Gun: đứng trên đầu boat với Y = Engine.Y + 150
            return CFrame.new(eng.Position.X, eng.Position.Y + GUN_Y_OFFSET_EXTRA, eng.Position.Z)
        end

        -- Logic cũ (không phải Gun)
        if mob.Name == "PirateGrandBrigade" or mob.Name == "PirateBrigade" then
            local offset = (mob.Name == "PirateGrandBrigade")
                and CFrame.new(0, -50, -50)
                or  CFrame.new(0, -30, -10)
            return eng.CFrame * offset
        elseif mob.Name == "FishBoat" then
            return eng.CFrame * CFrame.new(0, -50, -25)
        else
            return eng.CFrame * CFrame.new(0, 5, 0)
        end
    elseif data.isSeaBeast then
        local rp = mob:FindFirstChild("HumanoidRootPart")
        if not rp then return nil end
        if useGunLogic then
            -- Khi Gun: trả về vị trí tạm (Orbit sẽ override), Y + 100
            return CFrame.new(rp.Position.X, rp.Position.Y + GUN_ORBIT_Y_OFFSET, rp.Position.Z)
        end
        -- Logic cũ
        return CFrame.new(rp.Position.X, 35, rp.Position.Z)
    else
        -- Mob thường (Shark, Piranha, TerrorShark, FishCrew, Haunted...)
        local rp = mob:FindFirstChild("HumanoidRootPart")
        if not rp then return nil end

        if useGunLogic then
            local isExtra = (genvKey == "AutoHauntedCrewEnabled")
            local yOff = isExtra and GUN_Y_OFFSET_EXTRA or GUN_Y_OFFSET_NORMAL
            return CFrame.new(rp.Position.X, rp.Position.Y + yOff, rp.Position.Z)
        end

        -- Logic cũ theo weapon
        local wp = _G.ChooseWP or "Melee"
        local yOff
        if wp == "Melee" or wp == "Sword" then
            yOff = 40
        elseif wp == "Blox Fruit" then
            yOff = 15
        else
            yOff = 70  -- Gun (fallback, nhưng đã bị bắt ở trên)
        end
        return CFrame.new(rp.Position.X, rp.Position.Y + yOff, rp.Position.Z)
    end
end

-- ─── ORBIT / SPIN quanh SeaBeast (chỉ khi Gun) ───────────────────────
-- Quay liên tục quanh HRP của SeaBeast với bán kính 100, Y = mob.Y + 100
local orbitConn = nil
local orbitAngle = 0

local function StopOrbit()
    if orbitConn then
        orbitConn:Disconnect()
        orbitConn = nil
    end
    orbitAngle = 0
end

local function StartOrbitAroundSeaBeast(mob, stopFn)
    StopOrbit()
    if not mob or not IsGunWeapon() then return end

    local rp = mob:FindFirstChild("HumanoidRootPart")
    if not rp then return end

    orbitAngle = 0
    local lastTick = tick()

    orbitConn = RunService.Heartbeat:Connect(function()
        if stopFn and stopFn() then
            StopOrbit()
            return
        end
        if not IsMobAlive(mob, "AutoSeaBeastEnabled") or not IsPlayerAlive() then
            StopOrbit()
            return
        end

        -- Bỏ qua khi đang né skill SeaBeast (để Tween dodge chạy)
        if seaBeastIsDodging then
            lastTick = tick()
            return
        end

        local now = tick()
        local dt = now - lastTick
        lastTick = now

        orbitAngle = orbitAngle + GUN_ORBIT_SPEED * dt

        local center = rp.Position
        local offsetX = math.cos(orbitAngle) * GUN_ORBIT_RADIUS
        local offsetZ = math.sin(orbitAngle) * GUN_ORBIT_RADIUS
        local targetPos = Vector3.new(
            center.X + offsetX,
            center.Y + GUN_ORBIT_Y_OFFSET,
            center.Z + offsetZ
        )

        local char = player.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp then
            -- Giữ hướng nhìn về phía mob
            local lookAt = CFrame.lookAt(targetPos, center)
            pcall(function()
                hrp.CFrame = lookAt
            end)
        end
    end)
end

