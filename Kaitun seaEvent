-- ─── Né skill SeaBeast: phát hiện animation windup đang phát ─────────
local function DodgeSeabeasts()
    local seaBeastsFolder = Workspace.SeaBeasts
    for _, seaBeast in pairs(seaBeastsFolder:GetChildren()) do
        if seaBeast:FindFirstChild("Humanoid") and seaBeast:FindFirstChild("Anims") then
            local humanoid = seaBeast.Humanoid
            local animator  = humanoid:FindFirstChildOfClass("Animator") or humanoid
            for _, anim in pairs(seaBeast.Anims:GetChildren()) do
                if anim:IsA("Animation") then
                    if anim.AnimationId == "rbxassetid://8708221792"
                    or anim.AnimationId == "rbxassetid://8708222556"
                    or anim.AnimationId == "rbxassetid://8708223619"
                    or anim.AnimationId == "rbxassetid://8708225668" then
                        for _, animationTrack in pairs(animator:GetPlayingAnimationTracks()) do
                            if animationTrack.Animation.AnimationId == anim.AnimationId then
                                return animationTrack.IsPlaying
                            end
                        end
                    end
                end
            end
        end
    end
    return false
end

-- Hành động né: khi thấy SeaBeast dùng skill -> tween lên Y+150. Chờ tới khi
-- SeaBeast dùng skill xong HOẶC đã đợi 1s (tuỳ cái nào tới trước), rồi tween
-- xuống farm tiếp.

local function TweenBackToSeaBeastFarm()
    if getgenv().AutoSeaBeastEnabled then
        -- Nếu đang Orbit (Gun) thì chỉ cần tắt flag, Orbit sẽ tự resume
        if IsGunWeapon() and orbitConn then
            return
        end
        local mob = Workspace.SeaBeasts:FindFirstChild("SeaBeast1")
            or Workspace.SeaBeasts:FindFirstChild("SeaBeast")
        if mob then
            local tgtCF = GetMobFarmCFrame(mob, "AutoSeaBeastEnabled")
            if tgtCF then TweenTo(tgtCF) end
        end
    end
end

local function StartSeaBeastDodge()
    if seaBeastDodgeConn then return end
    seaBeastDodgeConn = RunService.Heartbeat:Connect(function()
        pcall(function()
            if DodgeSeabeasts() and not seaBeastIsDodging then
                seaBeastIsDodging = true

                local char = player.Character
                local hrp  = char and char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    TweenTo(hrp.CFrame + Vector3.new(0, 150, 0))
                end

                -- Chờ SeaBeast dùng skill xong hoặc tối đa 1s, cái nào tới trước
                task.spawn(function()
                    local waited = 0
                    while waited < 1 and DodgeSeabeasts() do
                        task.wait(0.05)
                        waited += 0.05
                    end

                    TweenBackToSeaBeastFarm()
                    seaBeastIsDodging = false
                end)
            end
        end)
    end)
end

-- ─── Né skill TerrorShark: theo dõi Y, tween lên +200 khi Y đổi ──────
local terrorSharkDodgeConn = nil
local terrorSharkBaseY     = nil
local terrorSharkIsDodging = false

local function StartTerrorSharkDodge()
    if terrorSharkDodgeConn then return end
    terrorSharkDodgeConn = RunService.Heartbeat:Connect(function()
        pcall(function()
            local mob = Workspace.Enemies:FindFirstChild("Terrorshark")
            if not mob then
                terrorSharkBaseY = nil
                terrorSharkIsDodging = false
                return
            end
            local rp = mob:FindFirstChild("HumanoidRootPart")
            if not rp then return end
            local currentY = rp.Position.Y

            if not terrorSharkBaseY then
                terrorSharkBaseY = currentY
                return
            end

            if math.abs(currentY - terrorSharkBaseY) > 1 then
                -- TerrorShark đang lên/xuống bất thường (chuẩn bị skill) -> né lên
                if not terrorSharkIsDodging then
                    terrorSharkIsDodging = true
                    local char = player.Character
                    local hrp  = char and char:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        TweenTo(hrp.CFrame + Vector3.new(0, 200, 0))
                    end
                end
            else
                -- TerrorShark về lại Y cũ -> tween về farm tiếp
                if terrorSharkIsDodging then
                    terrorSharkIsDodging = false
                    if getgenv().AutoTerrorSharkEnabled then
                        local tgtCF = GetMobFarmCFrame(mob, "AutoTerrorSharkEnabled")
                        if tgtCF then TweenTo(tgtCF) end
                    end
                end
                terrorSharkBaseY = currentY
            end
        end)
    end)
end

StartSeaBeastDodge()
StartTerrorSharkDodge()

