--// ================= [1] FAST ATTACK (Custom) - LUÔN BẬT =================
local FA_Modules = ReplicatedStorage:WaitForChild("Modules")
local FA_Net     = FA_Modules:WaitForChild("Net")

-- Nếu sau này tìm được remote ẩn (qua getgc/hookfunction) thì gán vào 2 biến này,
-- để nil thì nhánh mã hoá bên dưới tự bỏ qua, không lỗi.
local AttackRemoteTarget = nil
local AttackRemoteId     = nil

local function GetBladeHits_v1()
    local targets = {}
    local function GetDistance(v)
        return (v.Position - player.Character.HumanoidRootPart.Position).Magnitude
    end
    for _, part in pairs({Workspace.Enemies, Workspace.Characters}) do
        for _, v in pairs(part:GetChildren()) do
            if v:FindFirstChild("HumanoidRootPart") and v:FindFirstChild("Head") and v:FindFirstChild("Humanoid") then
                if GetDistance(v.HumanoidRootPart) < 60 then
                    table.insert(targets, v)
                end
            end
        end
    end
    return targets
end

local function AttackAll_v1()
    local character = player.Character
    if not character then return end
    local equippedWeapon = character:FindFirstChild("EquippedWeapon")
    if not equippedWeapon then return end

    local enemies = GetBladeHits_v1()
    if #enemies == 0 then return end

    local hitTargets = {}
    for i, v in pairs(enemies) do
        hitTargets[i] = {v, v.HumanoidRootPart}
    end

    local seed = FA_Modules.Net.seed:InvokeServer()

    local attackRemote = FA_Net:FindFirstChild("RE/RegisterAttack")
    local hitRemote     = FA_Net:FindFirstChild("RE/RegisterHit")

    if attackRemote and hitRemote then
        attackRemote:FireServer()

        local targetHead = hitTargets[1][1]:FindFirstChild("Head")
        if not targetHead then return end
        hitRemote:FireServer(targetHead, hitTargets, {})

        if AttackRemoteTarget then
            local remoteCode    = "RE/RegisterHit"
            local encryptionKey = math.floor(Workspace:GetServerTimeNow() / 10 % 10) + 1

            local encodedString = string.gsub(remoteCode, ".", function(char)
                return string.char(bit32.bxor(string.byte(char), encryptionKey))
            end)
            local finalId = bit32.bxor(AttackRemoteId + 909090, seed * 2)

            cloneref(AttackRemoteTarget):FireServer(
                encodedString,
                finalId,
                targetHead,
                hitTargets
            )
        end
    end
end

spawn(function()
    while task.wait() do
        if getgenv().FastAttackEnabled then
            pcall(AttackAll_v1)
        end
    end
end)

