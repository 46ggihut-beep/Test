local function DeepMergeDefault(default, user)
    user = user or {}
    for k, v in pairs(default) do
        if type(v) == "table" then
            user[k] = DeepMergeDefault(v, user[k])
        elseif user[k] == nil then
            user[k] = v
        end
    end
    return user
end

