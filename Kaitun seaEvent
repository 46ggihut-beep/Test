local function StartAutoAttack()
    if autoAttackConnection then return end
    autoAttackConnection = RunService.Heartbeat:Connect(function()
        pcall(function()
            if not _G.Seriality then return end
            AttackNoCoolDown()
            local Pretool = player.Character and player.Character:FindFirstChildOfClass("Tool")
            if not Pretool then return end
            local ToolTip = Pretool.ToolTip
            -- Fire fruit không cần kiểm tra range MobAura
